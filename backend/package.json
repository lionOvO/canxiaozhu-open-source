{
  "name": "canteen-helper-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "verify:permissions": "tsx scripts/verify-membership-access.ts",
    "verify:inventory": "tsx scripts/verify-inventory-closed-loop.ts",
    "verify:agent": "tsx scripts/verify-business-agent.ts",
    "verify:knowledge": "tsx scripts/verify-agent-knowledge.ts",
    "verify:knowledge:hybrid": "tsx scripts/verify-knowledge-hybrid.ts",
    "verify:knowledge:real": "tsx scripts/evaluate-knowledge-hybrid.ts",
    "verify:agent:scenarios": "tsx scripts/verify-agent-scenarios.ts",
    "verify:agent:real": "tsx scripts/verify-agent-scenarios.ts --real-model",
    "demo:agent": "tsx scripts/demo-agent-scenarios.ts",
    "demo:agent:real": "tsx scripts/demo-agent-scenarios.ts --real-model"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@langchain/openai": "^1.7.0",
    "@prisma/client": "^6.16.2",
    "fastify": "^5.11.0",
    "langchain": "^1.5.19",
    "openai": "^5.12.2",
    "pino-pretty": "^13.1.2",
    "typebox": "^1.0.22",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
